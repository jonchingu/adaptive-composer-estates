# Local secrets for the Worker. Copy to .dev.vars and fill in what you need:
#   cp .dev.vars.example .dev.vars
# In production, set them with `wrangler secret put TYPESAFE_API_KEY`.
#
# Everything is optional. With no key, /api/intent runs fully offline using the
# built-in keyword classifier ("jev-offline"), so the app works out of the box.
# Non-secret settings (JEV_MODEL, USE_MOCK, ESTATES_SOURCE, …) live in wrangler.jsonc "vars";
# a value here overrides them locally.

# TypeSafe AI API key. When set, intent classification uses the online Jev model.
# Get one at https://console.typesafe.ai/keys. Worker-only; never exposed to the browser.
TYPESAFE_API_KEY=

# Serve estates from the in-memory fixtures instead of D1 (no migrations needed).
# ESTATES_SOURCE=fixtures

# Browser-side: put VITE_USE_MOCK=true in .env.local to classify in the browser and skip /api/intent.
