{
  "name": "shapeshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:remote": "CF_REMOTE=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:seed": "bun scripts/seed.ts",
    "templates": "bun scripts/export-templates.ts",
    "db:migrate": "wrangler d1 migrations apply estates --local",
    "db:migrate:remote": "wrangler d1 migrations apply estates --remote",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "bun test",
    "format": "prettier --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convert-units": "^2.3.4",
    "date-fns": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "postgres": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.2",
    "@types/convert-units": "^2.3.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "An input that becomes what you mean, plus an estates composer. Vite SPA and a Hono API on Cloudflare Workers.",
  "license": "MIT",
  "type": "module"
}
